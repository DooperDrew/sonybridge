{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonyBridge",
  "version": "0.2.0",
  "identifier": "com.sonybridge.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "SonyBridge — WH-1000XM3 Companion",
        "width": 860,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
